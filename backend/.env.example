DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name

# ================================
# SERVER
# ================================
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ================================
# ADMIN ACCOUNT BOOTSTRAP (used only by npm run provision-admin)
# ================================
ADMIN_USERNAME=Refuoe Libete

# Generate a hash with: npm run hash -- <your-password>
# Replace this placeholder before running npm run provision-admin.
ADMIN_PASSWORD_HASH=replace_with_generated_bcrypt_hash

# Secret used to sign JWTs — set any long random string in production.
JWT_SECRET=change_me_to_a_long_random_secret_string

# How long a login stays valid.
JWT_EXPIRES_IN=8h