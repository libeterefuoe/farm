# ================================
# DATABASE
# ================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=railway

# ================================
# SERVER
# ================================
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ================================
# ADMIN AUTHENTICATION (single admin — no users table)
# ================================
# The admin username (trimmed, compared case-insensitively).
ADMIN_USERNAME=Refuoe Libete

# Bcrypt hash of the password "123456".
# Generated with:
#   cd backend
#   node scripts/hashPassword.js 123456
# Copy the printed hash and paste it below.
ADMIN_PASSWORD_HASH=$2a$10$REPLACE_THIS_WITH_YOUR_GENERATED_HASH

# Secret used to sign JWTs — set any long random string in production.
JWT_SECRET=change_me_to_a_long_random_secret_string

# How long a login stays valid.
JWT_EXPIRES_IN=8h