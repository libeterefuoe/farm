# =====================================================
# Batloung Farm Distribution Management System
# Root .gitignore
# =====================================================

# Dependencies
node_modules/
**/node_modules/

# Environment files — NEVER commit credentials
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Build output
dist/
build/
**/dist/
**/build/

# Vite cache
.vite/
**/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
**/logs/

# Coverage / test output
coverage/
**/coverage/
.nyc_output/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary / misc
.cache/
tmp/
temp/
*.tmp
*.bak
*.orig