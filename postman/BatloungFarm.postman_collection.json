{
  "info": {
    "_postman_id": "b4a9b0e0-1111-4aaa-bbbb-2c3d4e5f6001",
    "name": "Batloung Farm — DIWA2110",
    "description": "Postman collection covering every endpoint of the Batloung Farm Distribution Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Suppliers",
      "item": [
        { "name": "List suppliers",  "request": { "method": "GET", "url": "{{baseUrl}}/suppliers" } },
        { "name": "Get by id",       "request": { "method": "GET", "url": "{{baseUrl}}/suppliers/1" } },
        {
          "name": "Create supplier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_name\": \"Test Supplier 2025\",\n  \"contact_person\": \"Test Person\",\n  \"phone\": \"+27 11 999 9999\",\n  \"province\": \"Gauteng\",\n  \"address\": \"1 Test Street, Johannesburg\"\n}"
            },
            "url": "{{baseUrl}}/suppliers"
          }
        },
        {
          "name": "Update supplier",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_name\": \"Gauteng Fresh Produce\",\n  \"contact_person\": \"Thabo Mokoena\",\n  \"phone\": \"+27 11 555 1111\",\n  \"province\": \"Gauteng\",\n  \"address\": \"12 Market Road, Johannesburg\"\n}"
            },
            "url": "{{baseUrl}}/suppliers/1"
          }
        },
        { "name": "Delete supplier (expect 409)", "request": { "method": "DELETE", "url": "{{baseUrl}}/suppliers/1" } }
      ]
    },
    {
      "name": "Fruits",
      "item": [
        { "name": "List fruits", "request": { "method": "GET", "url": "{{baseUrl}}/fruits" } },
        {
          "name": "Create fruit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fruit_name\": \"Pineapples\",\n  \"description\": \"Sweet tropical pineapples\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/fruits"
          }
        },
        {
          "name": "Update fruit",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fruit_name\": \"Apples\",\n  \"description\": \"Crisp fresh apples\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/fruits/1"
          }
        }
      ]
    },
    {
      "name": "Stock",
      "item": [
        { "name": "List stock", "request": { "method": "GET", "url": "{{baseUrl}}/stock" } },
        { "name": "Low stock",  "request": { "method": "GET", "url": "{{baseUrl}}/stock/low" } }
      ]
    },
    {
      "name": "Vendors",
