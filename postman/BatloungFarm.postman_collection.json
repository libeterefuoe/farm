            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor_name\": \"Maseru Central Market\",\n  \"phone_number\": \"+266 5800 0001\",\n  \"location\": \"Maseru Central\",\n  \"registration_date\": \"2025-01-10\"\n}"
            },
            "url": "{{baseUrl}}/vendors/1"
          }
        }
      ]
    },
    {
      "name": "Purchases",
      "item": [
        { "name": "List purchases", "request": { "method": "GET", "url": "{{baseUrl}}/purchases" } },
