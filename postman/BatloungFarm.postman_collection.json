        },
        {
          "name": "Overpay (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_method\": \"CASH\",\n  \"amount\": 9999\n}"
            },
            "url": "{{baseUrl}}/sales/1/payments"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        { "name": "Top fruits",            "request": { "method": "GET", "url": "{{baseUrl}}/reports/top-fruits" } },
        { "name": "Revenue (June 2025)",   "request": { "method": "GET", "url": "{{baseUrl}}/reports/revenue?from=2025-06-01&to=2025-06-30" } },
        { "name": "Top vendor",            "request": { "method": "GET", "url": "{{baseUrl}}/reports/top-vendor" } },
        { "name": "Stock levels",          "request": { "method": "GET", "url": "{{baseUrl}}/reports/stock-levels" } },
