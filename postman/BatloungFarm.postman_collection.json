              "mode": "raw",
              "raw": "{\n  \"supplier_id\": 1,\n  \"items\": [\n    { \"fruit_id\": 1, \"packaging_size\": \"SMALL\",  \"quantity\": 5, \"unit_cost\": 15.00 },\n    { \"fruit_id\": 2, \"packaging_size\": \"MEDIUM\", \"quantity\": 4, \"unit_cost\": 30.00 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/purchases"
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        { "name": "List sales", "request": { "method": "GET", "url": "{{baseUrl}}/sales" } },
        { "name": "Get sale",   "request": { "method": "GET", "url": "{{baseUrl}}/sales/1" } },
        {
          "name": "Create sale — success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor_id\": 1,\n  \"payment_method\": \"CASH\",\n  \"amount_paid\": 90,\n  \"items\": [\n    { \"fruit_id\": 1, \"packaging_size\": \"MEDIUM\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/sales"
          }
        },
        {
          "name": "Create sale — FAIL (insufficient stock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor_id\": 1,\n  \"payment_method\": \"CASH\",\n  \"amount_paid\": 0,\n  \"items\": [\n    { \"fruit_id\": 1, \"packaging_size\": \"LARGE\",  \"quantity\": 10 },\n    { \"fruit_id\": 2, \"packaging_size\": \"SMALL\",  \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/sales"
          }
        },
        {
          "name": "Add payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_method\": \"MOBILE_MONEY\",\n  \"amount\": 100\n}"
            },
            "url": "{{baseUrl}}/sales/2/payments"
