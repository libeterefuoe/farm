        {
          "name": "Create vendor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor_name\": \"Test Vendor 2025\",\n  \"phone_number\": \"+266 5800 9999\",\n  \"location\": \"Maseru Test\",\n  \"registration_date\": \"2025-06-20\"\n}"
            },
            "url": "{{baseUrl}}/vendors"
